{
  "version": 2,
  "regions": ["bom1"],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "https://railpeek.jaganparidaa.workers.dev/",
      "permanent": false
    },
    {
      "source": "/((?!api/).*)",
      "destination": "https://railpeek.jaganparidaa.workers.dev/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
